{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nimo-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 阶段一使用 workers.dev 域名；阶段二绑定自定义域名后可改为 false
  "workers_dev": true,
  "preview_urls": false,

  // 部署 / 本地开发前，把 ../private/corpus 打包成 JSON（仅进入 Worker，不进入站点 dist，也不提交）
  "build": {
    "command": "node scripts/build-corpus.mjs",
    "watch_dir": ["src", "scripts", "../private/corpus"]
  },

  // 非密钥配置；DeepSeek 密钥请用 `npx wrangler secret put DEEPSEEK_API_KEY`
  "vars": {
    // 逗号分隔的 Origin 白名单（阶段二换域名时在这里追加）
    "ALLOWED_ORIGINS": "https://nimo0808.github.io,http://localhost:4321",
    // 一键关停：改为 "false" 后重新部署，/chat 返回 503 ai_disabled
    "AI_ENABLED": "true"
  },

  // Workers Rate Limiting binding：按访客 IP（CF-Connecting-IP）每 60 秒最多 5 次
  // 计数按 Cloudflare 机房（location）独立、最终一致，属于“防滥用”而非精确计费
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // 账号内唯一的整数字符串
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // 不开启 Workers Logs，避免记录请求/回答内容
  "observability": { "enabled": false }
}
