---
// src/layouts/BaseLayout.astro
// 自托管 Inter（替代 Google Fonts @import），字重与原来一致：300/400/500/600/700/900
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/900.css';
import { getAiEndpointCrossOrigin } from '../lib/ai-endpoint';

interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab } = Astro.props;

const siteName = 'NIMO · Mobin 莫彬';
const description = 'NIMO · Mobin 莫彬的设计作品集：数字体验设计、创意探索与产品开发。';

// 临时 noindex：作品尚未准备好。PUBLIC_SITE_INDEXABLE=true 时去掉
// （public/_headers 中的 X-Robots-Tag 行由 integrations/site-flags.mjs 按同一开关在构建时删除）。
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';

// CSP：Cloudflare 构建由 public/_headers 以响应头下发（含 frame-ancestors），这里不再输出 meta，避免两份策略冲突。
// GitHub Pages（DEPLOY_TARGET=github-pages）不能自定义响应头，只能用 <meta> 下发（meta CSP 不支持 frame-ancestors）。
// AI 端点为同源相对路径时 'self' 已覆盖；为绝对地址时，由 PUBLIC_AI_ENDPOINT 推导 origin 追加到 connect-src。
// 仅在生产构建中启用，避免影响 astro dev 的 HMR / Dev Toolbar 内联脚本。
const metaCspEnabled = import.meta.env.PROD && import.meta.env.DEPLOY_TARGET === 'github-pages';
const aiOrigin = getAiEndpointCrossOrigin();
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self'${aiOrigin ? ` ${aiOrigin}` : ''}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    {metaCspEnabled && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {!indexable && <meta name="robots" content="noindex" />}
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        color-scheme: light dark;
        --color-page-bg: #fff;
        --color-text-primary: #000;
        --color-text-secondary: #888;
        --color-text-muted: #aaa;
        --color-text-weak: #bbb;
        --color-project-summary: #000;
        --color-surface: #fff;
        --color-surface-hover: #fcfcfc;
        --color-bento-hover: #fcfcfc;
        --color-card-hover: #fafafa;
        --color-control-hover: #eaeaea;
        --color-surface-muted: #f9f9f9;
        --color-surface-subtle: #f5f5f5;
        --color-border: #eee;
        --color-border-subtle: #f9f9f9;
        --color-grid-border: #f2f2f2;
        --color-gallery-gap: #fff;
        --color-input-bg: #f4f4f4;
        --color-input-placeholder: #888;
        --color-button-bg: #000;
        --color-button-text: #fff;
        --color-focus-ring: #000;
        --color-footer-bg: #000;
        --color-footer-text: #fff;
        --color-footer-border: #000;
        --shadow-nav: 0 1px 0 transparent;
        --shadow-surface: 0 8px 30px rgb(0 0 0 / 4%);
        --logo-filter: none;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --color-page-bg: #000;
          --color-text-primary: #fff;
          --color-text-secondary: #b5b5b5;
          --color-text-muted: #8a8a8a;
          --color-text-weak: #777;
          --color-project-summary: #b5b5b5;
          --color-surface: #0a0a0a;
          --color-surface-hover: #141414;
          --color-bento-hover: #141414;
          --color-card-hover: #141414;
          --color-control-hover: #1f1f1f;
          --color-surface-muted: #101010;
          --color-surface-subtle: #141414;
          --color-border: #2a2a2a;
          --color-border-subtle: #1a1a1a;
          --color-grid-border: #242424;
          --color-gallery-gap: #1a1a1a;
          --color-input-bg: #141414;
          --color-input-placeholder: #777;
          --color-button-bg: #fff;
          --color-button-text: #000;
          --color-focus-ring: #fff;
          --color-footer-border: #242424;
          --shadow-nav: 0 1px 0 #1a1a1a;
          --shadow-surface: 0 8px 30px rgb(0 0 0 / 35%);
          --logo-filter: brightness(0) invert(1);
        }
      }

      /* 1. 核心：锁死滚动条宽度，无论内容长短，页面都不会左右晃动 */
      html { scrollbar-gutter: stable; }

      body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        background: var(--color-page-bg);
        color: var(--color-text-primary);
        -webkit-font-smoothing: antialiased;
        transition: background-color 180ms ease, color 180ms ease;
      }

      /* 2. 统一 Nav：物理像素锁死 */
      nav {
        position: fixed; top: 0; left: 0; width: 100%;
        display: flex; justify-content: space-between;
        padding: 0 40px; background: var(--color-page-bg); z-index: 1000;
        box-sizing: border-box; align-items: center;
        height: 80px; /* 强制高度 */
        box-shadow: var(--shadow-nav);
        transition: background-color 180ms ease, box-shadow 180ms ease;
      }
      .logo-link { display: flex; align-items: center; }
      .logo-img { height: 18px !important; width: auto; display: block; filter: none; } /* 锁死 Logo 高度 */

      .nav-links { display: flex; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; height: 80px; align-items: center; }
      .nav-links a {
        text-decoration: none; color: var(--color-text-primary); margin-left: 35px;
        font-weight: 500; /* 采用细体精致感 */
        padding: 6px 0;
        border-bottom: 1px solid transparent; /* 预留 1px 空间防止跳动 */
        transition: color 180ms ease, opacity 180ms ease, border-color 180ms ease;
      }
      .nav-links a.active { border-bottom-color: var(--color-text-primary); }
      .nav-links a:hover { opacity: 0.6; }
      .logo-link:focus-visible, .nav-links a:focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      @media (max-width: 768px) {
        nav { padding: 0 20px; }
        .nav-links a { margin-left: 15px; font-size: 10px; }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="logo-link">
        <img src="/images/photo/Top bar icons.png" alt="NIMO" class="logo-img" />
      </a>
      <div class="nav-links">
        <a href="/" class={activeTab === 'work' ? 'active' : ''}>Work</a>
        <a href="/lab" class={activeTab === 'lab' ? 'active' : ''}>Lab</a>
        <a href="/explore" class={activeTab === 'explore' ? 'active' : ''}>Explore</a>
      </div>
    </nav>
    <main><slot /></main>
  </body>
</html>
