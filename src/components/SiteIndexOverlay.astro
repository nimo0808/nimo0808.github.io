---
import { getSortedProjects } from '../lib/projects';

const getLatestYear = (year: string) => {
  const years = year.match(/\d{4}/g)?.map(Number) ?? [];
  return years.length > 0 ? Math.max(...years) : Number.NEGATIVE_INFINITY;
};

const projects = (await getSortedProjects()).sort((a, b) =>
  getLatestYear(b.data.year) - getLatestYear(a.data.year)
  || a.data.order - b.data.order
  || a.id.localeCompare(b.id),
);

const experiences = [
  { period: '2025–Present', company: 'Xiaomi (Shenzhen)', role: 'Design Expert' },
  { period: '2022–2025', company: 'Meizu (Zhuhai)', role: 'UX Manager' },
  { period: '2021–2022', company: 'Tencent (Shenzhen)', role: 'ISUX QQ Senior Visual Designer' },
  { period: '2021', company: 'Codema (Shenzhen)', role: 'Design Manager' },
  { period: '2017–2021', company: 'Meizu (Zhuhai)', role: 'Senior Visual Designer' },
];
---

<section
  id="site-index-overlay"
  class="site-index-overlay"
  data-open="false"
  aria-hidden="true"
  aria-label="工作经历与作品索引"
  hidden
  inert
>
  <div class="site-index-inner">
    <div class="experience-list" aria-label="工作经历">
      {experiences.map((experience) => (
        <div class="experience-item">
          <span class="experience-period">{experience.period}</span>
          <span class="experience-company">{experience.company}</span>
          <span class="experience-role">{experience.role}</span>
        </div>
      ))}
    </div>

    <div class="site-index-divider" aria-hidden="true"></div>

    <div class="project-index" aria-label="作品列表">
      {projects.map((project) => (
        <a class="project-index-row" href={`/projects/${project.id}/`} data-site-index-project>
          <span class="project-index-line">
            <span class="project-index-title">{project.data.title}</span>
            <span class="project-index-meta">
              <img
                class="project-index-cover"
                src={project.data.cover}
                alt=""
                width="72"
                height="54"
                decoding="async"
              />
              <span class="project-index-year">{project.data.year}</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .site-index-overlay {
    position: fixed;
    inset: 80px 0 0;
    z-index: 900;
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: var(--color-page-bg);
    color: var(--color-text-primary);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    clip-path: inset(0 0 3% 0);
    transition:
      opacity 240ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 240ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 240ms,
      background-color 180ms ease,
      color 180ms ease;
  }

  .site-index-overlay[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    clip-path: inset(0);
    transition-delay: 0s;
  }

  .site-index-inner {
    box-sizing: border-box;
    width: 100%;
    padding: 56px 40px 96px;
  }

  .experience-list {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    column-gap: 22px;
    row-gap: 13px;
    width: min(100%, 1040px);
  }

  .experience-item {
    display: contents;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
  }

  .experience-company,
  .experience-role {
    min-width: 0;
  }

  .experience-company,
  .experience-role {
    color: var(--color-text-primary);
  }

  .site-index-divider {
    width: 100%;
    margin-top: 54px;
    border-top: 1px solid var(--color-border);
  }

  .project-index-row {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 25px 8px 27px;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-primary);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .project-index-line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 14px;
    min-width: 0;
  }

  .project-index-title {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-family: 'Inter', sans-serif;
    font-size: clamp(28px, 3.8vw, 54px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .project-index-meta {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: flex-start;
    gap: 9px;
    padding-top: 2px;
  }

  .project-index-cover {
    display: block;
    width: 72px;
    height: 54px;
    object-fit: cover;
    background: var(--color-surface-muted);
    filter: none;
    transform: translateZ(0) scale(1);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-index-year {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .project-index-row:hover,
  .project-index-row:focus-visible {
    background: var(--color-surface-hover);
  }

  .project-index-row:hover .project-index-cover,
  .project-index-row:focus-visible .project-index-cover {
    transform: translateX(1px) scale(1.015);
  }

  .project-index-row:focus-visible {
    outline: 1px solid var(--color-focus-ring);
    outline-offset: -1px;
  }

  :global(body.site-index-open) {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .site-index-inner {
      padding: 42px 20px 72px;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .experience-item {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr);
      column-gap: 16px;
      align-items: start;
      font-size: 11px;
      line-height: 1.4;
    }

    .experience-period {
      grid-row: 1 / span 2;
      padding-top: 1px;
    }

    .experience-company,
    .experience-role {
      grid-column: 2;
      padding-left: 0;
    }

    .experience-role {
      margin-top: 3px;
    }

    .site-index-divider {
      margin-top: 40px;
    }

    .project-index-row {
      padding: 21px 4px 23px;
    }

    .project-index-line {
      gap: 8px 10px;
    }

    .project-index-title {
      font-size: clamp(28px, 8.8vw, 40px);
      line-height: 1;
    }

    .project-index-meta {
      gap: 7px;
      padding-top: 1px;
    }

    .project-index-year {
      font-size: 11px;
      line-height: 1.4;
    }

    .project-index-cover {
      width: 64px;
      height: 48px;
    }

    .project-index-year {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-index-overlay,
    .project-index-row,
    .project-index-cover {
      transition: none;
    }
  }
</style>

<script>
  const overlay = document.getElementById('site-index-overlay');
  const toggleButton = document.querySelector<HTMLButtonElement>('[data-site-index-toggle]');

  if (overlay instanceof HTMLElement && toggleButton instanceof HTMLButtonElement) {
    const firstProjectLink = overlay.querySelector<HTMLAnchorElement>('[data-site-index-project]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let closeTimer: number | undefined;

    const setButtonState = (open: boolean) => {
      toggleButton.setAttribute('aria-expanded', String(open));
      toggleButton.setAttribute(
        'aria-label',
        open ? '关闭工作经历与作品索引' : '打开工作经历与作品索引',
      );
    };

    const openOverlay = () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      overlay.hidden = false;
      overlay.inert = false;
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('site-index-open');
      setButtonState(true);

      window.requestAnimationFrame(() => {
        overlay.dataset.open = 'true';
        window.requestAnimationFrame(() => firstProjectLink?.focus({ preventScroll: true }));
      });
    };

    const closeOverlay = (returnFocus = true) => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      overlay.dataset.open = 'false';
      overlay.inert = true;
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('site-index-open');
      setButtonState(false);
      if (returnFocus) toggleButton.focus({ preventScroll: true });

      if (reducedMotion.matches) {
        overlay.hidden = true;
      } else {
        closeTimer = window.setTimeout(() => {
          overlay.hidden = true;
          closeTimer = undefined;
        }, 240);
      }
    };

    toggleButton.addEventListener('click', () => {
      if (toggleButton.getAttribute('aria-expanded') === 'true') {
        closeOverlay();
      } else {
        openOverlay();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggleButton.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        closeOverlay();
      }
    });
  }
</script>
