---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedProjects } from '../lib/projects';
import { EXPLORE_INTRO_TEXT } from '../data/explore-intro';

// 只嵌入公开项目元数据，用于推荐卡片；不包含任何项目正文或个人资料。
// AI 检索与回答全部在 Cloudflare Worker 中完成（见 /worker）。
const projectCards = (await getSortedProjects()).map((p) => ({
  slug: p.id,
  title: p.data.title,
  year: p.data.year,
  tags: p.data.tags,
  cover: p.data.cover,
}));
---

<BaseLayout title="Explore" activeTab="explore">
  <style is:global>
    .chat-container { max-width: 900px; margin: 0 auto; padding: 150px 40px 220px 40px; color: var(--color-text-primary); }
    .message-unit { margin-bottom: 80px; text-align: left; }
    .user-question { color: var(--color-text-weak) !important; font-size: 14px; margin-bottom: 20px; font-weight: 900; letter-spacing: 1px; display: block; overflow-wrap: anywhere; }
    .thinking-status { font-size: 10px; color: var(--color-text-weak) !important; letter-spacing: 2px; margin-bottom: 15px; animation: pulse 1.5s infinite; }
    .ai-answer, .fallback-notice { color: var(--color-text-primary); font-size: 18px; font-weight: 400; line-height: 1.7; }
    .ai-answer { overflow-wrap: anywhere; }
    .ai-answer :where(h1, h2, h3, h4, h5, h6, strong, b) { color: var(--color-text-primary); }
    .ai-answer a { color: var(--color-text-primary); text-decoration-color: var(--color-text-muted); }
    .ai-answer hr { border: none; height: 1px; background-color: var(--color-border); margin: 30px 0; }
    .ai-answer :where(code, pre) { background: var(--color-surface-muted); color: var(--color-text-primary); }
    .ai-answer pre { padding: 16px; overflow-x: auto; }
    .ai-answer blockquote { color: var(--color-text-secondary); border-left: 2px solid var(--color-border); margin-left: 0; padding-left: 18px; }
    .ai-answer :where(th, td) { border: 1px solid var(--color-border); }
    .result-grid { display: grid; grid-template-columns: repeat(auto-fill, 180px); gap: 16px; margin-top: 30px; width: 100%; box-sizing: border-box; }
    .project-card { width: 180px; border: 1px solid var(--color-border); padding: 8px; text-decoration: none; color: inherit; transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms ease, border-color 180ms ease; opacity: 0; transform: translateY(10px); background: var(--color-surface); display: block; box-sizing: border-box; }
    .project-card.show { opacity: 1; transform: translateY(0); }
    .project-card:hover { border-color: var(--color-border); background: var(--color-card-hover); }
    .project-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
    .project-card img { width: 162px !important; height: 121px !important; object-fit: cover !important; background: var(--color-surface-subtle); margin-bottom: 10px; display: block; filter: none; }
    .card-title { font-size: 11px; font-weight: 700; line-height: 1.3; color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-year { font-size: 9px; color: var(--color-text-muted); margin-top: 4px; }

    /* 素材区：导航(80px)与输入区(145px)之间 */
    .explore-empty { position: fixed; inset: 80px 0 145px; z-index: 1; overflow: hidden; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 220ms ease, visibility 0s linear 220ms; }
    .explore-empty[hidden] { display: none; }
    .explore-empty[data-state='visible'] { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
    /* 首次提问后复用同一组按钮，作为消息流首项收拢到正文左上方 */
    .explore-empty:is([data-state='transitioning'], [data-state='compact']) { position: relative; inset: auto; width: 100%; height: 55px; margin: 0 0 30px; overflow: visible; opacity: 1; visibility: visible; pointer-events: auto; transition: none; }
    /* 舞台高度保持输入区调整前的尺寸，并在新空间内垂直居中；作为容器查询基准让素材随舞台缩放 */
    .explore-empty-stage { position: relative; width: min(100%, 1100px); height: calc(100% - 30px); margin: 15px auto 0; container-type: size; }
    .explore-empty-button { position: absolute; display: block; margin: 0; padding: 0; appearance: none; -webkit-appearance: none; border: 0; outline: 0; background: transparent; box-shadow: none; color: inherit; line-height: 0; cursor: pointer; filter: none; transform: translateY(0) scale(1); transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), filter 220ms ease, opacity 180ms ease; }
    .explore-empty-button img { display: block; width: 100%; height: auto; max-width: none; user-select: none; -webkit-user-drag: none; object-fit: contain; filter: none; }
    .explore-empty[data-state='visible'] .explore-empty-button { animation: explore-item-in 320ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: var(--enter-delay, 0ms); }
    /* 开场衔接：素材由脚本在 img 上做模糊到清晰的显现，取代容器淡入和按钮位移入场 */
    .explore-empty[data-reveal='intro'] { transition: none; }
    .explore-empty[data-reveal='intro'] .explore-empty-button { animation: none; }
    .explore-empty-button:hover { transform: translateY(-4px) scale(1.015); filter: drop-shadow(0 9px 9px rgb(0 0 0 / 14%)); }
    .explore-empty-button:focus-visible { transform: translateY(-2px) scale(1.01); filter: drop-shadow(0 0 1px var(--color-focus-ring)) drop-shadow(0 7px 8px rgb(0 0 0 / 12%)); }
    .explore-empty-button:disabled { cursor: default; opacity: 0.55; }
    /* 开场超时后仍在加载的素材先不显示，decode 完成后去掉 data-pending 再单独入场 */
    .explore-empty[data-state='visible'] .explore-empty-button[data-pending] { visibility: hidden; pointer-events: none; animation: none; }
    .explore-empty[data-state='transitioning'] .explore-empty-button { animation: none; transition: none; transform: none; filter: none; opacity: 1; pointer-events: none; }
    .explore-empty:is([data-state='transitioning'], [data-state='compact']) .explore-empty-stage { display: flex; align-items: center; justify-content: flex-start; gap: 10px; width: 100%; height: 55px; margin: 0; container-type: normal; }
    .explore-empty:is([data-state='transitioning'], [data-state='compact']) .explore-empty-button { position: relative; inset: auto; flex: 0 0 51px; width: 51px; height: 51px; margin: 0; }
    .explore-empty:is([data-state='transitioning'], [data-state='compact']) .explore-empty-button--person { flex-basis: 29px; width: 29px; }
    .explore-empty:is([data-state='transitioning'], [data-state='compact']) .explore-empty-button img { width: 100%; height: 100%; }
    .explore-empty[data-state='compact'] .explore-empty-button:not(:disabled):hover { transform: translateY(-2px) scale(1.015); filter: drop-shadow(0 6px 7px rgb(0 0 0 / 14%)); }
    .explore-empty[data-state='compact'] .explore-empty-button:focus-visible { transform: translateY(-1px) scale(1.01); }
    /* --w 素材宽度、--o 垂直偏移。基准 1440×900（舞台 1100×645）下为原像素值，舞台更矮或更窄时等比缩小 */
    .explore-empty-button--person { --w: 182px; left: 50%; top: 50%; width: var(--w); margin-top: calc(var(--w) * -0.9615); margin-left: calc(var(--w) * -0.5); --enter-delay: 90ms; }
    .explore-empty-button--shirt { --w: 189px; --o: 26px; top: calc(27.925% - var(--o)); left: calc(3% + 11px); width: var(--w); --enter-delay: 20ms; }
    .explore-empty-button--camera { --w: 198px; --o: 25.5px; top: calc(28.7% - var(--o)); right: calc(2% + 11px); width: var(--w); --enter-delay: 55ms; }
    .explore-empty-button--basketball { --w: 189px; --o: 26px; bottom: calc(20.925% - var(--o)); left: calc(7% + 11px); width: var(--w); --enter-delay: 125ms; }
    .explore-empty-button--drink { --w: 185px; --o: 26.5px; right: calc(6% + 10px); bottom: calc(20.7% - var(--o)); width: var(--w); --enter-delay: 160ms; }
    @supports (width: 1cqh) {
      .explore-empty-button--person { --w: min(182px, 28.22cqh, 16.55cqw); }
      .explore-empty-button--shirt { --w: min(189px, 29.3cqh, 17.18cqw); --o: min(26px, 4.03cqh); }
      .explore-empty-button--camera { --w: min(198px, 30.7cqh, 18cqw); --o: min(25.5px, 3.95cqh); }
      .explore-empty-button--basketball { --w: min(189px, 29.3cqh, 17.18cqw); --o: min(26px, 4.03cqh); }
      .explore-empty-button--drink { --w: min(185px, 28.68cqh, 16.82cqw); --o: min(26.5px, 4.11cqh); }
    }

    /* 加载开场：与素材区同一区域，文字静态居中；字号与颜色跟随 #userInput 的提示文字 */
    .explore-intro { position: fixed; inset: 80px 0 145px; z-index: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; pointer-events: none; }
    .explore-intro[hidden] { display: none; }
    /* 兜底：极小屏幕文字超出可见区时，从顶部排起、可在区域内滚动，上下边缘用 mask 渐隐；文字上下留出渐隐高度，滚到两端时首尾行完整可读 */
    .explore-intro[data-overflow] { align-items: flex-start; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; pointer-events: auto; -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%); mask-image: linear-gradient(to bottom, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%); }
    .explore-intro[data-overflow]::-webkit-scrollbar { display: none; }
    .explore-intro[data-overflow] .explore-intro-text { padding-top: 24px; padding-bottom: 24px; }
    /* 消散开始后不再响应滚动与点击，下方素材可直接点击 */
    .explore-intro[data-dissolving] { overflow-y: hidden; pointer-events: none; }
    .explore-intro-text { box-sizing: border-box; width: 100%; max-width: 640px; margin: 0; padding: 0 40px; color: var(--color-input-placeholder); font-size: 16px; font-weight: 400; line-height: 1.7; font-kerning: none; font-variant-ligatures: none; overflow-wrap: break-word; user-select: none; }
    .explore-intro-word { display: inline-block; white-space: nowrap; }
    .explore-intro-char { display: inline-block; }
    .explore-intro-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

    /* 分割线 → 输入框 42px，输入框 60px，输入框 → 屏幕底部 42px（总高 145px） */
    .input-wrapper { position: fixed; bottom: 0; left: 0; z-index: 10; width: 100%; background: var(--color-page-bg); padding: 42px 0 42px 0; border-top: 1px solid var(--color-border-subtle); transition: background-color 180ms ease, border-color 180ms ease; }
    .input-box { max-width: 800px; margin: 0 auto; padding: 0 40px; position: relative; box-sizing: border-box; }
    #userInput { width: 100%; background: var(--color-input-bg); color: var(--color-text-primary); border: none; border-radius: 40px; height: 60px; padding: 0 80px 0 35px; font-size: 16px; outline: none; box-sizing: border-box; transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease; }
    #userInput::placeholder { color: var(--color-input-placeholder); opacity: 1; }
    #userInput:focus-visible { box-shadow: inset 0 0 0 1px rgb(0 0 0 / 3%); }
    #sendBtn { position: absolute; right: 55px; top: 50%; transform: translateY(-50%); background: var(--color-button-bg); color: var(--color-button-text); border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 20px; transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease; }
    #sendBtn svg { width: 19px; height: 19px; display: block; fill: none; stroke: currentColor; transform: translate(0, 0) rotate(-90deg); transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1); }
    #sendBtn:not(:disabled):hover svg { transform: translate(0, -1px) rotate(-90deg); }
    #sendBtn:disabled { opacity: 0.4; cursor: default; }

    /* 离线兜底：提示 + 预设问题 */
    .fallback-notice { margin: 0 0 18px 0; }
    .fallback-questions { display: flex; flex-wrap: wrap; gap: 10px; }
    .fallback-question { background: var(--color-input-bg); border: none; border-radius: 40px; padding: 10px 18px; font: inherit; font-size: 13px; color: var(--color-text-primary); cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
    .fallback-question:hover { background: var(--color-control-hover); }
    .fallback-question:focus-visible, #sendBtn:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }

    @media (prefers-color-scheme: dark) {
      #userInput:focus-visible { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 3%); }
      .explore-empty-button:hover { filter: drop-shadow(0 1px 2px rgb(255 255 255 / 15%)) drop-shadow(0 9px 10px rgb(0 0 0 / 55%)); }
      .explore-empty-button:focus-visible { filter: drop-shadow(0 0 1px rgb(255 255 255 / 65%)) drop-shadow(0 7px 9px rgb(0 0 0 / 50%)); }
    }

    @media (max-width: 768px) {
      .explore-intro-text { padding: 0 24px; }
      .explore-empty:is([data-state='transitioning'], [data-state='compact']) .explore-empty-stage { gap: 8px; }
      /* 手机基准 390×844（舞台 390×589）下为原像素值，更矮或更窄时等比缩小 */
      .explore-empty-button--person { --w: 118px; margin-top: calc(var(--w) * -0.983); }
      .explore-empty-button--shirt { --w: 122px; --o: 21.7px; top: calc(26.375% - var(--o)); left: 7px; }
      .explore-empty-button--camera { --w: 122px; --o: 20.8px; top: calc(26.375% - var(--o)); right: 7px; }
      .explore-empty-button--basketball { --w: 131px; --o: 1.7px; bottom: calc(21.375% - var(--o)); left: 7px; }
      .explore-empty-button--drink { --w: 131px; --o: 4.8px; right: 7px; bottom: calc(21.375% - var(--o)); }
      @supports (width: 1cqh) {
        .explore-empty-button--person { --w: min(118px, 20.03cqh, 30.26cqw); }
        .explore-empty-button--shirt { --w: min(122px, 20.71cqh, 31.28cqw); --o: min(21.7px, 3.68cqh); }
        .explore-empty-button--camera { --w: min(122px, 20.71cqh, 31.28cqw); --o: min(20.8px, 3.53cqh); }
        .explore-empty-button--basketball { --w: min(131px, 22.24cqh, 33.59cqw); --o: min(1.7px, 0.29cqh); }
        .explore-empty-button--drink { --w: min(131px, 22.24cqh, 33.59cqw); --o: min(4.8px, 0.81cqh); }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .explore-empty,
      .explore-empty-button { transition: none; }
      .explore-empty[data-state='visible'] .explore-empty-button { animation: none; }
    }

    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    @keyframes explore-item-in { from { opacity: 0; transform: translateY(6px) scale(0.995); } to { opacity: 1; transform: translateY(0) scale(1); } }
  </style>

  <div class="explore-empty" id="exploreEmpty" data-page-transition-fixed data-state="hidden" aria-label="快捷问题" aria-hidden="true" hidden inert>
    <div class="explore-empty-stage">
      <button class="explore-empty-button explore-empty-button--shirt" type="button" data-empty-question="你如何理解系统体验与视觉风格的关系？" aria-label="发送问题：你如何理解系统体验与视觉风格的关系？">
        <img src="/images/explore/shirt.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--camera" type="button" data-empty-question="介绍一下你开发的 Pixelcam" aria-label="发送问题：介绍一下你开发的 Pixelcam">
        <img src="/images/explore/camera.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--person" type="button" data-empty-question="介绍一下你的职业经历" aria-label="发送问题：介绍一下你的职业经历">
        <img src="/images/explore/person.png" alt="" width="625" height="1200" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--basketball" type="button" data-empty-question="工作之外，你有哪些兴趣？" aria-label="发送问题：工作之外，你有哪些兴趣？">
        <img src="/images/explore/basketball.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--drink" type="button" data-empty-question="你通常如何发掘创意灵感？" aria-label="发送问题：你通常如何发掘创意灵感？">
        <img src="/images/explore/drink.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
    </div>
  </div>

  <div class="explore-intro" id="exploreIntro" data-page-transition-fixed hidden>
    <p class="explore-intro-sr">{EXPLORE_INTRO_TEXT}</p>
    <p class="explore-intro-text" data-intro-text aria-hidden="true">{EXPLORE_INTRO_TEXT}</p>
  </div>

  <div class="chat-container" id="chatContainer"></div>
  <div class="input-wrapper" data-page-transition-fixed>
    <div class="input-box">
        <input type="text" id="userInput" placeholder="Ask Nimo about projects or skills..." autocomplete="off" maxlength="500" aria-label="向 NIMO 的 AI 助手提问" />
        <button id="sendBtn" type="button" aria-label="发送">
          <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <path d="M3.5 9h11M10.5 5l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
          </svg>
        </button>
    </div>
  </div>

  <div id="explore-data" data-projects={JSON.stringify(projectCards)} hidden></div>

  <script>
    import '../scripts/explore';
  </script>
</BaseLayout>
