---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedProjects } from '../lib/projects';

// 只嵌入公开项目元数据，用于推荐卡片；不包含任何项目正文或个人资料。
// AI 检索与回答全部在 Cloudflare Worker 中完成（见 /worker）。
const projectCards = (await getSortedProjects()).map((p) => ({
  slug: p.id,
  title: p.data.title,
  year: p.data.year,
  tags: p.data.tags,
  cover: p.data.cover,
}));
---

<BaseLayout title="Explore" activeTab="explore">
  <style is:global>
    .chat-container { max-width: 900px; margin: 0 auto; padding: 150px 40px 250px 40px; color: var(--color-text-primary); }
    .message-unit { margin-bottom: 80px; text-align: left; }
    .user-question { color: var(--color-text-weak) !important; font-size: 14px; margin-bottom: 20px; font-weight: 900; letter-spacing: 1px; display: block; overflow-wrap: anywhere; }
    .thinking-status { font-size: 10px; color: var(--color-text-weak) !important; letter-spacing: 2px; margin-bottom: 15px; animation: pulse 1.5s infinite; }
    .ai-answer, .fallback-notice { color: var(--color-text-primary); font-size: 18px; font-weight: 400; line-height: 1.7; }
    .ai-answer { overflow-wrap: anywhere; }
    .ai-answer :where(h1, h2, h3, h4, h5, h6, strong, b) { color: var(--color-text-primary); }
    .ai-answer a { color: var(--color-text-primary); text-decoration-color: var(--color-text-muted); }
    .ai-answer hr { border: none; height: 1px; background-color: var(--color-border); margin: 30px 0; }
    .ai-answer :where(code, pre) { background: var(--color-surface-muted); color: var(--color-text-primary); }
    .ai-answer pre { padding: 16px; overflow-x: auto; }
    .ai-answer blockquote { color: var(--color-text-secondary); border-left: 2px solid var(--color-border); margin-left: 0; padding-left: 18px; }
    .ai-answer :where(th, td) { border: 1px solid var(--color-border); }
    .result-grid { display: grid; grid-template-columns: repeat(auto-fill, 180px); gap: 16px; margin-top: 30px; width: 100%; box-sizing: border-box; }
    .project-card { width: 180px; border: 1px solid var(--color-border); padding: 8px; text-decoration: none; color: inherit; transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 180ms ease, border-color 180ms ease; opacity: 0; transform: translateY(10px); background: var(--color-surface); display: block; box-sizing: border-box; }
    .project-card.show { opacity: 1; transform: translateY(0); }
    .project-card:hover { border-color: var(--color-border); background: var(--color-card-hover); }
    .project-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
    .project-card img { width: 162px !important; height: 121px !important; object-fit: cover !important; background: var(--color-surface-subtle); margin-bottom: 10px; display: block; filter: none; }
    .card-title { font-size: 11px; font-weight: 700; line-height: 1.3; color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-year { font-size: 9px; color: var(--color-text-muted); margin-top: 4px; }

    .explore-empty { position: fixed; inset: 80px 0 175px; z-index: 1; overflow: hidden; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 220ms ease, visibility 0s linear 220ms; }
    .explore-empty[hidden] { display: none; }
    .explore-empty[data-state='visible'] { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
    .explore-empty-stage { position: relative; width: min(100%, 1100px); height: 100%; margin: 0 auto; }
    .explore-empty-button { position: absolute; display: block; margin: 0; padding: 0; appearance: none; -webkit-appearance: none; border: 0; outline: 0; background: transparent; box-shadow: none; color: inherit; line-height: 0; cursor: pointer; filter: none; transform: translateY(0) scale(1); transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), filter 220ms ease; }
    .explore-empty-button img { display: block; width: 100%; height: auto; max-width: none; user-select: none; -webkit-user-drag: none; filter: none; }
    .explore-empty[data-state='visible'] .explore-empty-button { animation: explore-item-in 320ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: var(--enter-delay, 0ms); }
    .explore-empty-button:hover { transform: translateY(-4px) scale(1.015); filter: drop-shadow(0 9px 9px rgb(0 0 0 / 14%)); }
    .explore-empty-button:focus-visible { transform: translateY(-2px) scale(1.01); filter: drop-shadow(0 0 1px var(--color-focus-ring)) drop-shadow(0 7px 8px rgb(0 0 0 / 12%)); }
    .explore-empty-button--person { left: 50%; top: 50%; width: 182px; margin-top: -175px; margin-left: -91px; --enter-delay: 90ms; }
    .explore-empty-button--shirt { top: calc(27.925% - 26px); left: calc(3% + 11px); width: 189px; --enter-delay: 20ms; }
    .explore-empty-button--camera { top: calc(28.7% - 25.5px); right: calc(2% + 11px); width: 198px; --enter-delay: 55ms; }
    .explore-empty-button--basketball { bottom: calc(20.925% - 26px); left: calc(7% + 11px); width: 189px; --enter-delay: 125ms; }
    .explore-empty-button--drink { right: calc(6% + 10px); bottom: calc(20.7% - 26.5px); width: 185px; --enter-delay: 160ms; }

    .input-wrapper { position: fixed; bottom: 0; left: 0; z-index: 10; width: 100%; background: var(--color-page-bg); padding: 52px 0 58.5px 0; border-top: 1px solid var(--color-border-subtle); transition: background-color 180ms ease, border-color 180ms ease; }
    .input-box { max-width: 800px; margin: 0 auto; padding: 0 40px; position: relative; box-sizing: border-box; }
    #userInput { width: 100%; background: var(--color-input-bg); color: var(--color-text-primary); border: none; border-radius: 40px; padding: 22px 80px 22px 35px; font-size: 16px; outline: none; box-sizing: border-box; transition: background-color 180ms ease, color 180ms ease, box-shadow 180ms ease; }
    #userInput::placeholder { color: var(--color-input-placeholder); opacity: 1; }
    #userInput:focus-visible { box-shadow: inset 0 0 0 1px rgb(0 0 0 / 3%); }
    #sendBtn { position: absolute; right: 55px; top: 50%; transform: translateY(-50%); background: var(--color-button-bg); color: var(--color-button-text); border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 20px; transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease; }
    #sendBtn svg { width: 19px; height: 19px; display: block; fill: none; stroke: currentColor; transform: translate(0, 0) rotate(-90deg); transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1); }
    #sendBtn:not(:disabled):hover svg { transform: translate(0, -1px) rotate(-90deg); }
    #sendBtn:disabled { opacity: 0.4; cursor: default; }

    /* 离线兜底：提示 + 预设问题 */
    .fallback-notice { margin: 0 0 18px 0; }
    .fallback-questions { display: flex; flex-wrap: wrap; gap: 10px; }
    .fallback-question { background: var(--color-input-bg); border: none; border-radius: 40px; padding: 10px 18px; font: inherit; font-size: 13px; color: var(--color-text-primary); cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
    .fallback-question:hover { background: var(--color-control-hover); }
    .fallback-question:focus-visible, #sendBtn:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }

    @media (prefers-color-scheme: dark) {
      #userInput:focus-visible { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 3%); }
      .explore-empty-button:hover { filter: drop-shadow(0 1px 2px rgb(255 255 255 / 15%)) drop-shadow(0 9px 10px rgb(0 0 0 / 55%)); }
      .explore-empty-button:focus-visible { filter: drop-shadow(0 0 1px rgb(255 255 255 / 65%)) drop-shadow(0 7px 9px rgb(0 0 0 / 50%)); }
    }

    @media (max-width: 768px) {
      .explore-empty-button--person { width: 118px; margin-top: -116px; margin-left: -59px; }
      .explore-empty-button--shirt { top: calc(26.375% - 21.7px); left: 7px; width: 122px; }
      .explore-empty-button--camera { top: calc(26.375% - 20.8px); right: 7px; width: 122px; }
      .explore-empty-button--basketball { bottom: calc(21.375% - 1.7px); left: 7px; width: 131px; }
      .explore-empty-button--drink { right: 7px; bottom: calc(21.375% - 4.8px); width: 131px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .explore-empty,
      .explore-empty-button { transition: none; }
      .explore-empty[data-state='visible'] .explore-empty-button { animation: none; }
    }

    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    @keyframes explore-item-in { from { opacity: 0; transform: translateY(6px) scale(0.995); } to { opacity: 1; transform: translateY(0) scale(1); } }
  </style>

  <div class="explore-empty" id="exploreEmpty" data-state="hidden" aria-label="快捷问题" aria-hidden="true" hidden inert>
    <div class="explore-empty-stage">
      <button class="explore-empty-button explore-empty-button--shirt" type="button" data-empty-question="你如何理解系统体验与视觉风格的关系？" aria-label="发送问题：你如何理解系统体验与视觉风格的关系？">
        <img src="/images/explore/shirt.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--camera" type="button" data-empty-question="介绍一下你开发的 Pixelcam" aria-label="发送问题：介绍一下你开发的 Pixelcam">
        <img src="/images/explore/camera.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--person" type="button" data-empty-question="介绍一下你的职业经历" aria-label="发送问题：介绍一下你的职业经历">
        <img src="/images/explore/person.png" alt="" width="625" height="1200" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--basketball" type="button" data-empty-question="工作之外，你有哪些兴趣？" aria-label="发送问题：工作之外，你有哪些兴趣？">
        <img src="/images/explore/basketball.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
      <button class="explore-empty-button explore-empty-button--drink" type="button" data-empty-question="你通常如何发掘创意灵感？" aria-label="发送问题：你通常如何发掘创意灵感？">
        <img src="/images/explore/drink.png" alt="" width="600" height="420" decoding="async" draggable="false" />
      </button>
    </div>
  </div>

  <div class="chat-container" id="chatContainer"></div>
  <div class="input-wrapper">
    <div class="input-box">
        <input type="text" id="userInput" placeholder="Ask Nimo about projects or skills..." autocomplete="off" maxlength="500" aria-label="向 NIMO 的 AI 助手提问" />
        <button id="sendBtn" type="button" aria-label="发送">
          <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <path d="M3.5 9h11M10.5 5l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path>
          </svg>
        </button>
    </div>
  </div>

  <div id="explore-data" data-projects={JSON.stringify(projectCards)} hidden></div>

  <script>
    import '../scripts/explore';
  </script>
</BaseLayout>
