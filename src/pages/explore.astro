---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedProjects } from '../lib/projects';

// 只嵌入公开项目元数据，用于推荐卡片；不包含任何项目正文或个人资料。
// AI 检索与回答全部在 Cloudflare Worker 中完成（见 /worker）。
const projectCards = (await getSortedProjects()).map((p) => ({
  slug: p.id,
  title: p.data.title,
  year: p.data.year,
  tags: p.data.tags,
  cover: p.data.cover,
}));
---

<BaseLayout title="Explore" activeTab="explore">
  <style is:global>
    .chat-container { max-width: 900px; margin: 0 auto; padding: 150px 40px 250px 40px; }
    .message-unit { margin-bottom: 80px; text-align: left; }
    .user-question { color: #BBB !important; font-size: 14px; margin-bottom: 20px; font-weight: 900; letter-spacing: 1px; display: block; overflow-wrap: anywhere; }
    .thinking-status { font-size: 10px; color: #BBB !important; letter-spacing: 2px; margin-bottom: 15px; animation: pulse 1.5s infinite; }
    .ai-answer { color: #000; font-size: 18px; line-height: 1.7; overflow-wrap: anywhere; }
    .ai-answer hr { border: none; height: 1px; background-color: #EEE; margin: 30px 0; }
    .result-grid { display: grid; grid-template-columns: repeat(auto-fill, 180px); gap: 16px; margin-top: 30px; width: 100%; box-sizing: border-box; }
    .project-card { width: 180px; border: 1px solid #eee; padding: 8px; text-decoration: none; color: inherit; transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1); opacity: 0; transform: translateY(10px); background: #fff; display: block; box-sizing: border-box; }
    .project-card.show { opacity: 1; transform: translateY(0); }
    .project-card:hover { border-color: #eee; background: #fafafa; }
    .project-card img { width: 162px !important; height: 121px !important; object-fit: cover !important; background: #f5f5f5; margin-bottom: 10px; display: block; }
    .card-title { font-size: 11px; font-weight: 700; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-year { font-size: 9px; color: #aaa; margin-top: 4px; }
    .input-wrapper { position: fixed; bottom: 0; left: 0; width: 100%; background: white; padding: 52px 0 28px 0; border-top: 1px solid #f9f9f9; }
    .input-box { max-width: 800px; margin: 0 auto; padding: 0 40px; position: relative; box-sizing: border-box; }
    #userInput { width: 100%; background: #f4f4f4; border: none; border-radius: 40px; padding: 22px 80px 22px 35px; font-size: 16px; outline: none; box-sizing: border-box; }
    #sendBtn { position: absolute; right: 55px; top: 50%; transform: translateY(-50%); background: #000; color: #fff; border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    #sendBtn:disabled { opacity: 0.4; cursor: default; }
    .privacy-note { max-width: 800px; margin: 14px auto 0 auto; padding: 0 40px; box-sizing: border-box; font-size: 11px; line-height: 1.5; color: #AAA; text-align: center; }

    /* 离线兜底：提示 + 预设问题 */
    .fallback-notice { font-size: 14px; line-height: 1.6; color: #888; margin: 0 0 18px 0; }
    .fallback-questions { display: flex; flex-wrap: wrap; gap: 10px; }
    .fallback-question { background: #f4f4f4; border: none; border-radius: 40px; padding: 10px 18px; font: inherit; font-size: 13px; color: #000; cursor: pointer; transition: background 0.2s ease; }
    .fallback-question:hover { background: #eaeaea; }
    .fallback-question:focus-visible, #sendBtn:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
  </style>

  <div class="chat-container" id="chatContainer"></div>
  <div class="input-wrapper">
    <div class="input-box">
        <input type="text" id="userInput" placeholder="Ask Nimo about projects or skills..." autocomplete="off" maxlength="500" aria-label="向 NIMO 的 AI 助手提问" />
        <button id="sendBtn" type="button" aria-label="发送">↑</button>
    </div>
    <p class="privacy-note">你的提问及最近几条对话会发送到第三方 AI 服务（DeepSeek）生成回答；对话只临时保存在当前浏览器标签页，关闭即清除，本站服务器不保存。</p>
  </div>

  <div id="explore-data" data-projects={JSON.stringify(projectCards)} hidden></div>

  <script>
    import '../scripts/explore';
  </script>
</BaseLayout>
