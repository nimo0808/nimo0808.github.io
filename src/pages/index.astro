---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedProjects } from '../lib/projects';

// 1. 获取项目数据（按 frontmatter order 排序，全部渲染，不再截断）
const realProjects = await getSortedProjects();

// 2. 原设计为 14 格：项目不足 14 个时用占位卡补齐网格；超过时全部展示
const minSlots = 14;
const placeholderCount = Math.max(0, minSlots - realProjects.length);
const placeholders = Array.from({ length: placeholderCount }, (_, i) => realProjects.length + i);
---

<BaseLayout title="Work" activeTab="work">
  <style>
    /* --- 1. Hero 品牌区 --- */
    .hero-section {
      padding: 140px 40px 180px 40px;
      background: var(--color-page-bg);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 75vh;
      transition: background-color 180ms ease;
    }
    .hero-container {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 80px;
      max-width: 1000px;
      width: 100%;
    }
    /* 桌面保持 460px；窄屏按视口收缩（减去移动端左右 20px 内边距），避免横向溢出 */
    .hero-logo-box { position: relative; flex: 0 0 auto; width: min(460px, calc(100vw - 40px)); height: min(460px, calc(100vw - 40px)); display: flex; align-items: center; justify-content: center; }
    #logo-container { width: 100%; height: 100%; filter: var(--logo-filter); opacity: 1; transition: filter 180ms ease, opacity 120ms ease; }
    .hero-logo-sequence { position: absolute; inset: 20%; width: 60%; height: 60%; object-fit: contain; opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
    .hero-logo-box.is-sequence-active #logo-container { opacity: 0; }
    .hero-logo-box.is-sequence-active .hero-logo-sequence { opacity: 1; }
    .hero-logo-sequence.is-settled { animation: logo-sequence-settle 120ms ease-out both; }
    @keyframes logo-sequence-settle {
      from { transform: scale(0.985); filter: contrast(0.96); }
      to { transform: scale(1); filter: contrast(1); }
    }
    .hero-text-content { flex: 1; max-width: 420px; }
    .hero-title { font-size: 56px; margin: 0; line-height: 1; letter-spacing: -0.05em; font-weight: 900; text-transform: uppercase; color: var(--color-text-primary); }
    .hero-desc { font-size: 22px; color: var(--color-text-primary); margin-top: 25px; line-height: 1.35; font-weight: 400; letter-spacing: -0.01em; }
    .hero-annotated { white-space: nowrap; }
    .hero-note { font-size: 10px; color: var(--color-text-secondary); line-height: 0; font-weight: 400; letter-spacing: 0; vertical-align: super; white-space: nowrap; cursor: pointer; transition: color 120ms ease; }
    .hero-note:hover, .hero-note:focus { color: var(--color-text-primary); }
    .hero-note:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }

    @media (hover: none), (pointer: coarse) {
      .hero-note { cursor: default; }
      .hero-note:hover { color: var(--color-text-secondary); }
    }

    @media (prefers-reduced-motion: reduce) {
      #logo-container, .hero-logo-sequence { transition: none; }
      .hero-logo-sequence.is-settled { animation: none; }
    }

    /* --- 2. 作品宫格核心逻辑 --- */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-left: 1px solid var(--color-border-subtle);
      box-sizing: border-box;
    }
    .bento-item {
      background: var(--color-surface);
      padding: 60px 40px;
      text-decoration: none;
      color: inherit;
      display: block;
      box-sizing: border-box;
      border-right: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
      transition: background-color 180ms ease, border-color 180ms ease;
    }
    .bento-item.is-real:hover { background: var(--color-bento-hover); }
    .bento-item.is-real:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: -2px; }

    .visual-container { width: 100%; aspect-ratio: 4/3; background: var(--color-surface-muted); overflow: hidden; margin-bottom: 28px; transition: background-color 180ms ease; }
    .bento-item img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); transition: filter 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .bento-item.is-real:hover img { filter: grayscale(0%); transform: scale(1.02); }

    .category-tag { font-size: 11px; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 2px; font-weight: 500; display: block; }
    .project-title { font-size: 24px; margin: 2px 0 0 0; font-weight: 700; letter-spacing: -0.02em; color: var(--color-text-primary); display: block; }
    .is-placeholder .category-tag { opacity: 0.3; }
    .is-placeholder .project-title { opacity: 0.1; }
    .is-placeholder .visual-container { background: var(--color-surface-subtle); }

    /* --- 3. 黑色底部：物理对齐与描述增强 --- */
    .site-footer {
      margin-top: 180px;
      background: var(--color-footer-bg);
      color: var(--color-footer-text);
      border-top: 1px solid var(--color-footer-border);
      /* 核心对齐：左右 40px 间距使内部元素边缘与上方图片边缘严格对齐 */
      padding: 120px 40px;
      display: flex;
      justify-content: center;
      box-sizing: border-box;
      transition: border-color 180ms ease;
    }

    .footer-inner {
      width: 100%;
      /* 这里的 max-width 应该根据布局灵活调整，目前通过 space-between 实现两端对齐 */
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 60px;
    }

    .footer-graphic {
      flex: 0 0 auto;
    }

    .footer-brand-img {
      width: 120px;
      height: auto;
      display: block;
      filter: none;
    }

    .footer-content {
      flex: 0 1 auto;
      text-align: left;
      /* 绿色线条对应优化：加宽文本容器，增强横向气场 */
      max-width: 900px;
    }

    .footer-content h2 {
      font-size: 32px;
      font-weight: 900;
      margin: 0 0 12px 0;
      letter-spacing: 0px;
    }

    /* 新文案样式 */
    .footer-desc {
      font-size: 18px;
      line-height: 1.4;
      color: var(--color-footer-text);
      margin-bottom: 100px; /* 留出间距给底部联系方式 */
      font-weight: 400;
    }

    .footer-contact {
      font-size: 18px;
      line-height: 1.4;
      font-weight: 500;
      color: var(--color-footer-text);
    }

    /* 响应式适配 */
    @media (max-width: 1024px) {
      .hero-container { gap: 40px; max-width: 800px; }
      .footer-inner { gap: 40px; }
    }

    @media (max-width: 768px) {
      .hero-section { padding: 80px 20px 100px 20px; }
      /* gap 8px：Logo 图形可见底边 → NIMO 字母顶部的视觉距离约 100px（动画画布底部自带约 85px 留白） */
      .hero-container { flex-direction: column; text-align: center; gap: 8px; }
      /* 手机端 Logo 动画等比缩小（容器 350px → 290px，可见 Logo 约 158px → 131px） */
      .hero-logo-box { width: min(290px, calc(100vw - 40px)); height: min(290px, calc(100vw - 40px)); }
      .site-footer { padding: 80px 20px; margin-top: 100px; }
      .footer-inner { flex-direction: column; align-items: center; text-align: center; }
      .footer-content { text-align: center; }
      .bento-grid { grid-template-columns: 1fr; }
    }
  </style>

  <!-- 1. Hero Section -->
  <section class="hero-section">
    <div class="hero-container">
      <div class="hero-logo-box">
        <div id="logo-container"></div>
        <img class="hero-logo-sequence" alt="" aria-hidden="true" decoding="async" />
      </div>
      <div class="hero-text-content">
        <h1 class="hero-title">NIMO</h1>
        <p class="hero-desc">
          Focusing on digital experience <span class="hero-annotated">design<sup class="hero-note" role="button" tabindex="0" data-logo-target="4" aria-controls="logo-container">01 系统体验设计</sup></span>, creative <span class="hero-annotated">exploration<sup class="hero-note" role="button" tabindex="0" data-logo-target="3" aria-controls="logo-container">02 创意视觉</sup></span>, and AI-native product <span class="hero-annotated">development<sup class="hero-note" role="button" tabindex="0" data-logo-target="5" aria-controls="logo-container">03 产品开发</sup></span>.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Work Grid（全部项目 + 不足 14 格时的占位卡） -->
  <section id="work" class="bento-grid">
    {realProjects.map((project) => (
      <a href={`/projects/${project.id}`} class="bento-item is-real">
        <div class="visual-container">
          <img src={project.data.cover} alt={project.data.title} />
        </div>
        <span class="category-tag">{project.data.year} / {project.data.tags[0] || 'Design'}</span>
        <h2 class="project-title">{project.data.title}</h2>
      </a>
    ))}
    {placeholders.map((index) => (
      <div class="bento-item is-placeholder">
        <div class="visual-container"></div>
        <span class="category-tag">Coming Soon / 0{index + 1}</span>
        <h2 class="project-title">Project Archive</h2>
      </div>
    ))}
  </section>

  <!-- 3. Integrated Black Footer (Precision Aligned) -->
  <footer class="site-footer">
    <div class="footer-inner">
      <!-- 左侧：图形边缘与上方图片左边缘对齐 -->
      <div class="footer-graphic">
        <img src="/images/photo/Bottom Brand Graphic.png" alt="Nimo Graphic" class="footer-brand-img" />
      </div>

      <!-- 右侧：长描述文案，宽度拉开 -->
      <div class="footer-content">
        <h2>NIMO</h2>
        <p class="footer-desc">
          Focusing on digital experience design, creative exploration, and product innovation — partnering with leading brands including Xiaomi, Meizu, Tencent, Codemao, Ones, Geely, Polestar, and Lynk & Co to shape next-generation intelligent experiences.
        </p>

        <div class="footer-contact">
          <div>Tel : 13530771729</div>
          <div>Mail : 1255926879@qq.Com</div>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // light 版只含 svg 渲染器、不含 expressions（logodata.json 未使用 expressions），不依赖 eval
    import lottie from 'lottie-web/build/player/lottie_light';

    const logoContainer = document.getElementById('logo-container');
    const logoBox = document.querySelector<HTMLElement>('.hero-logo-box');
    const heroSection = document.querySelector<HTMLElement>('.hero-section');
    const sequenceImage = document.querySelector<HTMLImageElement>('.hero-logo-sequence');
    const notes = document.querySelectorAll<HTMLElement>('.hero-note[data-logo-target]');

    if (logoContainer && logoBox && heroSection && sequenceImage) {
      const animation = lottie.loadAnimation({
        container: logoContainer,
        renderer: 'svg',
        loop: true,
        autoplay: true,
        path: '/images/data/logodata.json'
      });
      const frameSources = [
        '/images/logo-sequence/brand-1-cc0af93c.jpg',
        '/images/logo-sequence/brand-2-e3205caa.webp',
        '/images/logo-sequence/brand-3-8984d76d.webp',
        '/images/logo-sequence/brand-4-6b71845e.webp',
        '/images/logo-sequence/brand-5-d2462d72.webp'
      ];
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const connection = (navigator as Navigator & {
        connection?: EventTarget & { saveData?: boolean; effectiveType?: string };
      }).connection;
      const desktopFrameDelay = 80;
      const mobileFrameDelay = 120;
      const mobileFinalDelay = 500;
      const restoreDelay = 120;
      let generation = 0;
      let sequenceController: AbortController | null = null;
      let restoreTimer: number | null = null;
      let hoveredNote: HTMLElement | null = null;
      let focusedNote: HTMLElement | null = null;
      let lottieReady = false;
      let heroIsVisible = false;
      let destroyed = false;
      let mobileState: 'idle' | 'qualifying' | 'loading' | 'playing' | 'done' = 'idle';
      let mobileQualificationStartedAt = 0;
      let mobileHasShownFrame = false;
      let sequenceOwner: 'desktop' | 'mobile' | null = null;

      let frameLoads: Promise<boolean>[] | null = null;

      const ensureFrameLoads = () => {
        if (frameLoads) return frameLoads;

        frameLoads = frameSources.map((source) => new Promise<boolean>((resolve) => {
          const image = new Image();
          image.decoding = 'async';
          image.onload = async () => {
            if (typeof image.decode !== 'function') {
              resolve(true);
              return;
            }
            try {
              await image.decode();
              resolve(true);
            } catch {
              resolve(false);
            }
          };
          image.onerror = () => resolve(false);
          image.src = source;
        }));
        return frameLoads;
      };

      const cancelRestore = () => {
        if (restoreTimer !== null) {
          window.clearTimeout(restoreTimer);
          restoreTimer = null;
        }
      };

      const waitForDelay = (signal: AbortSignal, delay: number) => new Promise<boolean>((resolve) => {
        let timer: number;
        const onAbort = () => {
          window.clearTimeout(timer);
          resolve(false);
        };
        timer = window.setTimeout(() => {
          signal.removeEventListener('abort', onAbort);
          resolve(true);
        }, delay);
        signal.addEventListener('abort', onAbort, { once: true });
      });

      const showFrame = (frame: number) => {
        sequenceImage.classList.remove('is-settled');
        sequenceImage.src = frameSources[frame - 1];
      };

      const showLottie = (restartFromBeginning = false) => {
        generation += 1;
        sequenceController?.abort();
        sequenceController = null;
        sequenceOwner = null;
        sequenceImage.classList.remove('is-settled');
        logoBox.classList.remove('is-sequence-active');
        if (restartFromBeginning) animation.goToAndPlay(0, true);
        else animation.play();
        restoreTimer = null;
      };

      const mobileIsSuppressed = () => {
        const effectiveType = connection?.effectiveType;
        return reducedMotion.matches
          || connection?.saveData === true
          || effectiveType === 'slow-2g'
          || effectiveType === '2g';
      };

      const mobileCanQualify = () => !destroyed
        && lottieReady
        && !finePointer.matches
        && !mobileIsSuppressed()
        && heroIsVisible
        && document.visibilityState === 'visible';

      const cancelMobileAuto = () => {
        if (mobileState === 'idle' || mobileState === 'done') return;

        const mustFinish = mobileHasShownFrame;
        showLottie(true);
        mobileQualificationStartedAt = 0;
        mobileState = mustFinish ? 'done' : 'idle';
      };

      const reconcileMobileAuto = () => {
        if (!mobileCanQualify()) {
          cancelMobileAuto();
          return;
        }
        if (mobileState !== 'idle') return;

        generation += 1;
        sequenceController?.abort();
        sequenceController = null;
        sequenceOwner = null;
        mobileState = 'qualifying';
        mobileQualificationStartedAt = performance.now();
        animation.goToAndPlay(0, true);
      };

      const startDesktopSequence = async (target: number, note: HTMLElement) => {
        if (!finePointer.matches) return;

        cancelRestore();
        generation += 1;
        const currentGeneration = generation;
        sequenceController?.abort();
        sequenceController = new AbortController();
        sequenceOwner = 'desktop';
        const { signal } = sequenceController;
        const frameResults = await Promise.all(ensureFrameLoads());
        const noteIsActive = hoveredNote === note || focusedNote === note;

        if (signal.aborted || currentGeneration !== generation || !noteIsActive || !finePointer.matches) return;
        if (!frameResults.every(Boolean)) {
          showLottie();
          return;
        }

        showFrame(reducedMotion.matches ? target : 1);
        logoBox.classList.add('is-sequence-active');
        animation.pause();

        if (reducedMotion.matches) return;

        const frames = [1, 2, 3, 4, 5, ...Array.from({ length: target }, (_, index) => index + 1)];
        for (const frame of frames.slice(1)) {
          if (!(await waitForDelay(signal, desktopFrameDelay))) return;
          if (signal.aborted || currentGeneration !== generation || !finePointer.matches) return;
          showFrame(frame);
        }

        sequenceImage.classList.add('is-settled');
      };

      const startMobileSequence = async () => {
        if (mobileState !== 'qualifying' || !mobileCanQualify()) return;

        mobileState = 'loading';
        generation += 1;
        const currentGeneration = generation;
        sequenceController?.abort();
        sequenceController = new AbortController();
        sequenceOwner = 'mobile';
        const { signal } = sequenceController;
        const frameResults = await Promise.all(ensureFrameLoads());

        if (signal.aborted || currentGeneration !== generation || mobileState !== 'loading') return;
        if (!mobileCanQualify() || !frameResults.every(Boolean)) {
          if (!frameResults.every(Boolean)) {
            mobileState = 'done';
            showLottie(true);
          } else {
            cancelMobileAuto();
          }
          return;
        }

        mobileState = 'playing';
        mobileHasShownFrame = true;
        showFrame(1);
        logoBox.classList.add('is-sequence-active');
        animation.pause();

        for (const frame of [2, 3, 4, 5]) {
          if (!(await waitForDelay(signal, mobileFrameDelay))) return;
          if (signal.aborted || currentGeneration !== generation || !mobileCanQualify()) return;
          showFrame(frame);
        }

        if (!(await waitForDelay(signal, mobileFinalDelay))) return;
        if (signal.aborted || currentGeneration !== generation || !mobileCanQualify()) return;

        logoBox.classList.remove('is-sequence-active');
        animation.goToAndPlay(0, true);
        if (!(await waitForDelay(signal, restoreDelay))) return;
        if (signal.aborted || currentGeneration !== generation) return;

        sequenceController = null;
        sequenceOwner = null;
        mobileState = 'done';
      };

      const handleLoopComplete = () => {
        if (mobileState !== 'qualifying' || !mobileCanQualify()) return;

        const cycleDuration = animation.getDuration(false) * 1000;
        const watchedDuration = performance.now() - mobileQualificationStartedAt;
        if (watchedDuration + 100 < cycleDuration) {
          mobileQualificationStartedAt = performance.now();
          animation.goToAndPlay(0, true);
          return;
        }
        void startMobileSequence();
      };

      const handleLottieReady = () => {
        lottieReady = true;
        reconcileMobileAuto();
      };

      const scheduleRestore = () => {
        if (hoveredNote || focusedNote) return;
        cancelRestore();
        restoreTimer = window.setTimeout(() => showLottie(), restoreDelay);
      };

      const targetFor = (note: HTMLElement) => Number(note.dataset.logoTarget);

      const handleFinePointerChange = () => {
        hoveredNote = null;
        focusedNote = null;
        cancelRestore();
        if (sequenceOwner === 'mobile' || mobileState === 'qualifying') cancelMobileAuto();
        else showLottie(!finePointer.matches);

        if (finePointer.matches) {
          void Promise.all(ensureFrameLoads());
          return;
        }
        reconcileMobileAuto();
      };

      const handleMobileConditionChange = () => reconcileMobileAuto();
      const handleVisibilityChange = () => reconcileMobileAuto();

      const heroObserver = new IntersectionObserver(([entry]) => {
        heroIsVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.6);
        reconcileMobileAuto();
      }, { threshold: [0, 0.6] });

      animation.addEventListener('DOMLoaded', handleLottieReady);
      animation.addEventListener('loopComplete', handleLoopComplete);
      heroObserver.observe(heroSection);
      finePointer.addEventListener('change', handleFinePointerChange);
      reducedMotion.addEventListener('change', handleMobileConditionChange);
      connection?.addEventListener('change', handleMobileConditionChange);
      document.addEventListener('visibilitychange', handleVisibilityChange);

      if (finePointer.matches) void Promise.all(ensureFrameLoads());

      notes.forEach((note) => {
        note.addEventListener('pointerenter', () => {
          if (!finePointer.matches) return;
          hoveredNote = note;
          void startDesktopSequence(targetFor(note), note);
        });
        note.addEventListener('pointerleave', () => {
          if (hoveredNote === note) hoveredNote = null;
          scheduleRestore();
        });
        note.addEventListener('focus', () => {
          if (!finePointer.matches) return;
          focusedNote = note;
          void startDesktopSequence(targetFor(note), note);
        });
        note.addEventListener('blur', () => {
          if (focusedNote === note) focusedNote = null;
          scheduleRestore();
        });
      });

      window.addEventListener('pagehide', () => {
        destroyed = true;
        cancelRestore();
        sequenceController?.abort();
        sequenceController = null;
        heroObserver.disconnect();
        animation.removeEventListener('DOMLoaded', handleLottieReady);
        animation.removeEventListener('loopComplete', handleLoopComplete);
        finePointer.removeEventListener('change', handleFinePointerChange);
        reducedMotion.removeEventListener('change', handleMobileConditionChange);
        connection?.removeEventListener('change', handleMobileConditionChange);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        animation.destroy();
      }, { once: true });
    }
  </script>
</BaseLayout>