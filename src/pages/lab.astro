---
import BaseLayout from '../layouts/BaseLayout.astro';

// Lab 数据列表
const labItems = [
  { type: 'image', url: '/images/photo/square_02.png' },
  { type: 'image', url: '/images/photo/square_02.png' },
  { type: 'image', url: '/images/photo/square_03.png' },
  { type: 'image', url: '/images/photo/square_04.png' },
  { type: 'image', url: '/images/photo/square_Cover01.png' },
  // 这里可以继续增加，如果只有 5 个，剩下的 3 个格子会自动变白
];
---

<BaseLayout title="Lab" activeTab="lab">
  <style>
    .lab-container {
      padding: 240px 40px 160px 40px;
      min-height: 100vh;
      background: var(--color-page-bg);
      color: var(--color-text-primary);
      transition: background-color 180ms ease, color 180ms ease;
    }

    .lab-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: var(--color-surface);
    }

    .lab-item {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-surface);
      border-right: 1px solid var(--color-grid-border);
      border-bottom: 1px solid var(--color-grid-border);
      transition: background-color 180ms ease, border-color 180ms ease;
    }

    .lab-grid {
      border-top: 1px solid var(--color-grid-border);
      border-left: 1px solid var(--color-grid-border);
    }

    .lab-item img, .lab-item video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: none;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lab-item:hover img, .lab-item:hover video {
      transform: scale(1.05);
    }

    /* 响应式调整 */
    @media (max-width: 1024px) {
      .lab-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .lab-grid { grid-template-columns: 1fr; }
      .lab-container { padding: 100px 20px; }
    }
  </style>

  <div class="lab-container">
    <div class="lab-grid">
      {labItems.map((item) => (
        <div class="lab-item">
          {item.type === 'video' ? (
            <video 
              src={item.url} 
              muted 
              loop 
              playsinline 
              class="lab-video"
            ></video>
          ) : (
            <img src={item.url} alt="Nimo Lab Research" loading="lazy" />
          )}
        </div>
      ))}
    </div>
  </div>

  <script>
    const videos = document.querySelectorAll<HTMLVideoElement>('.lab-video');
    videos.forEach((video) => {
      const parent = video.parentElement;
      if (!parent) return;
      parent.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });
      parent.addEventListener('mouseleave', () => {
        video.pause();
      });
    });
  </script>
</BaseLayout>